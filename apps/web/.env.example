# Optional. Leave unset to use the bundled Next.js /v1 API routes.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional. Enables Hugging Face neural detector layers in the bundled /v1 API routes.
HF_TOKEN=
HF_TEXT_MODEL=desklib/ai-text-detector-v1.01
HF_IMAGE_MODEL=haywoodsloan/ai-image-detector-dev-deploy
HF_INFERENCE_ENDPOINT_BASE=https://router.huggingface.co/hf-inference/models
